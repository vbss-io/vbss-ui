{
  "name": "vbss-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbss-io/vbss-ui.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/vbss-io"
    },
    {
      "type": "individual",
      "url": "https://buymeacoffee.com/vbss.io"
    }
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "lerna run build --concurrency 2",
    "docs:dev": "cd apps/docs && npm run dev",
    "docs:build": "cd apps/docs && npm run build",
    "eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:coverage": "node scripts/test-coverage.mjs",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lock-guard": "node scripts/clean-vite-temp.mjs && node .github/lock-guard.mjs --base origin/main --installed .",
    "audit-gate": "node scripts/audit-gate.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "verify": "npm run lint && npm run typecheck:tests && npm run test:coverage && npm run lock-guard && npm run audit-gate && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.0",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/js": "^9.21.0",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-storybook": "^0.11.3",
    "eslint-plugin-styled-components-a11y": "^2.2.0",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "lerna": "^10.1.1",
    "postcss": "^8.5.10",
    "prettier": "^3.5.3",
    "storybook": "^8.6.19",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^5.0.5"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "overrides": {
    "@eslint/plugin-kit": "^0.3.4",
    "@octokit/plugin-paginate-rest": "^9.2.2",
    "@octokit/request": "^8.4.1",
    "@octokit/request-error": "^5.1.1",
    "@microsoft/tsdoc-config": {
      "ajv": "^8.18.0"
    },
    "@rushstack/node-core-library": {
      "ajv": "^8.18.0"
    },
    "axios": "^1.15.0",
    "fast-uri": "^3.1.2",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.4",
    "glob@^10": "^11.0.0",
    "handlebars": "^4.7.9",
    "ip-address": "^10.1.1",
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.0",
    "minimatch@^3": "^3.1.4",
    "minimatch@^5": "^5.1.8",
    "minimatch@^6": "^6.2.2",
    "minimatch@^9": "^9.0.7",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.10",
    "prismjs": "^1.30.0",
    "react-router": "^7.12.0",
    "react-router-dom": "^7.12.0",
    "rollup": "^4.59.0",
    "semver": "^7.5.2",
    "tar": "^7.5.11",
    "tmp": "^0.2.4",
    "yaml": "^2.8.3",
    "nx": {
      "undici": "7.30.1"
    },
    "@storybook/addon-actions": {
      "uuid": "11.1.1"
    }
  }
}
